#!/bin/sh
# SPDX-License-Identifier: MIT
#
# Extension tests on the checked-out Virt image (docs/spec.md §29): merge the admin
# extension on demand and use its tools, with the desktop not merged at boot (no GPU here);
# then offer tampered and unsigned copies of the admin image, which must all be refused
# (docs/security.md §15). The image itself is never modified.
#   ./ci/test-extensions [path/to/disk.raw]

# shellcheck source=ci/lib.sh
. "$(dirname "$0")/lib.sh"

image="${1:-$OUT/disk.raw}"
[ -f "$image" ] || die "$image not found; run ./ci/image first"
log "admin extension: merge on demand"
python3 "$REPO/tools/qemu-test.py" --arch "$ARCH" --image "$image" \
    --extra-unit "$REPO/tests/vm/beamline-admin-check.service" \
    --wants beamline-admin-check.service \
    --kernel-arg systemd.mask=systemd-sysext.service \
    --kernel-arg systemd.mask=systemd-confext.service \
    --require BEAMLINE_SELINUX_OK --expect BEAMLINE_ADMIN_OK \
    --log "$(dirname "$image")/serial-admin.log"

log "extension trust: tampered and unsigned images are refused"
admin="$(dirname "$image")/extensions/admin.sysext.raw"
[ -f "$admin" ] || die "$admin not found; run ./ci/image first"
python3 "$REPO/tools/qemu-test.py" --arch "$ARCH" --image "$image" \
    --attach-tampered "$admin:signature" --attach-tampered "$admin:data" \
    --attach-tampered "$admin:unsigned" \
    --extra-unit "$REPO/tests/vm/beamline-extension-trust.service" \
    --wants beamline-extension-trust.service \
    --kernel-arg systemd.mask=systemd-sysext.service \
    --kernel-arg systemd.mask=systemd-confext.service \
    --kernel-arg systemd.mask=beamline-extensions-link.service \
    --require BEAMLINE_SELINUX_OK --expect BEAMLINE_EXTENSION_TRUST_OK \
    --log "$(dirname "$image")/serial-trust.log"
