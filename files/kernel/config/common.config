# SPDX-License-Identifier: MIT
#
# Shared by every profile kernel. Applied on top of the architecture defconfig.
# Anything listed here is verified to survive `make olddefconfig`.

# Release string is <version><profile LOCALVERSION>, never a git-derived suffix
# CONFIG_LOCALVERSION_AUTO is not set

# systemd requirements
CONFIG_DEVTMPFS=y
CONFIG_CGROUPS=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_UNIX=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_FHANDLE=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_AUTOFS_FS=y
CONFIG_PSI=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y

# Boot: UEFI, UKI, systemd initrd
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y

# systemd credentials from the hypervisor (SMBIOS type 11)
CONFIG_DMI=y
CONFIG_DMI_SYSFS=y

# Filesystems: ESP, bring-up root, future immutable root and verity, sysext overlays
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EXT4_FS=y
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
