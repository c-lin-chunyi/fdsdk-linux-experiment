# SPDX-License-Identifier: MIT
#
# Virt profile: the virtual hardware contract (docs/spec.md §4) built in so the
# boot path never depends on module loading.

CONFIG_LOCALVERSION="-myos-virt"

CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_FW_CFG_SYSFS=y
