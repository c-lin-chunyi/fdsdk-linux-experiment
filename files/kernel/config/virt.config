# SPDX-License-Identifier: MIT
#
# Virt profile: the virtual hardware contract (docs/spec.md §4) built in so the boot path
# never depends on module loading. Applied on top of allnoconfig (§11.4), so the menus
# that default to "y" are requested explicitly.

CONFIG_LOCALVERSION="-beamline-virt"

CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_INPUT=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_FW_CFG_SYSFS=y
