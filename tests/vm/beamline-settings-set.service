# SPDX-License-Identifier: MIT
#
# VM test (ci/test-settings, docs/spec.md §14, docs/decisions.md D56), first boot: change
# allowlisted settings through their systemd services, which write /etc's mutable layer on
# DATA, and put a file outside the allowlist into /etc (permissive Stage 0 lets it land in the
# layer; an enforcing boot refuses it). Then reboot. Never part of an image.

[Unit]
Description=Change allowlisted /etc settings, add a file outside the allowlist, reboot
ConditionFirstBoot=yes
ConditionPathExists=!/etc/initrd-release
After=beamline-boot-ok.service

[Service]
Type=oneshot
StandardOutput=journal+console
ExecStart=/usr/bin/hostnamectl set-hostname beamline-settings-test
ExecStart=/usr/bin/hostnamectl set-location beamline-test-bench
ExecStart=/usr/bin/timedatectl set-timezone Europe/Berlin
ExecStart=/usr/bin/localectl set-locale LANG=C.UTF-8
ExecStart=-/usr/bin/systemd-tmpfiles --create --inline "f /etc/beamline-forbidden 0644 - - - outside the allowlist"
ExecStart=/usr/bin/systemctl --no-block reboot
